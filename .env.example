# Copie para /root/veu/engine/.env no servidor (chmod 600). NÃO commitar secrets.

# Chat / modelos
OPENAI_API_KEY=
OPENROUTER_API_KEY=
VEU_OPENAI_MODEL=gpt-5.4-nano
VEU_OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OLLAMA_BASE_URL=http://127.0.0.1:11434
VEU_OLLAMA_MODEL=qwen3.5:0.8b

# Jev (TypeSafe System One)
TYPESAFE_API_KEY=
VEU_JEV_MODEL=jev-1.13.0
TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# Notion
NOTION_TOKEN=
NOTION_VERSION=2022-06-28

# OpenRAG (memória documental)
OPENRAG_API_KEY=
OPENRAG_URL=https://ragpro.ch8ai.com.br

# Grok Bot — routine "Handoff do Véu" (painel Routines)
VEU_GROKBOT_WEBHOOK_URL=
VEU_GROKBOT_WEBHOOK_SECRET=
# alias aceito:
# VEU_GROKBOT_SEND_KEY=
VEU_GROKBOT_API_BASE=
XAI_API_KEY=

# Kernel
VEU_ECC_ROOT=/root/veu/vendor/ecc
VEU_DATA_ROOT=/root/.veu/data

# Auth — fecha o plano de controle (P0). Cookie HttpOnly + Google OAuth e/ou senha.
# VEU_AUTH_PASSWORD=
# VEU_AUTH_SECRET=  # opcional; se vazio deriva da senha/secret Google
VEU_PUBLIC_URL=https://veu.ch8ai.com.br
VEU_AUTH_COOKIE_SECURE=1
# VEU_AUTH_ORIGINS=https://veu.ch8ai.com.br
# Google OAuth (console.cloud.google.com) — redirect:
#   https://veu.ch8ai.com.br/auth/google/callback
VEU_GOOGLE_CLIENT_ID=
VEU_GOOGLE_CLIENT_SECRET=
# E-mails autorizados (vírgula). Vazio = qualquer conta Google (não use em prod).
# VEU_AUTH_GOOGLE_EMAILS=voce@gmail.com


# Control kiosk — live.json que o Grok Bot já grava (Outlook/Teams/Gmail/agenda)
# Default no servidor: /var/www/control-kiosk/live.json
# VEU_CONTROL_LIVE_PATH=/var/www/control-kiosk/live.json

# Servidores cadastrados em Ajustes → servidores
# Metadados em $VEU_DATA_ROOT/servers.json; senha só aqui (mascarada na UI):
# VEU_SRV_<HEX>_PASSWORD=
# Ex.: id srv-ab12cd34ef → VEU_SRV_AB12CD34EF_PASSWORD=
